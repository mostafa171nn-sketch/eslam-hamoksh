# ---- Maarech frontend environment ------------------------------------------

# Backend the client-side `/api/*` proxy targets. REQUIRED for real (prod)
# builds unless NEXT_PUBLIC_UI_DEMO_DATA=true.
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Frontend-only static demo-data mode. When set to "true" the UI renders rich
# realistic static content (src/demo/) with NO backend — no Prisma/DB needed.
# Defaults to off; real API calls remain untouched.
# NEXT_PUBLIC_UI_DEMO_DATA=true

# Demo accounts (password for all = Demo@12345):
#   superadmin        -> SUPER_ADMIN
#   demo.center.admin1 -> CENTER_ADMIN (مركز النيل للتعليم)
#   demo.teacher.1    -> TEACHER
#   demo.student.1    -> STUDENT
#   demo.parent.1     -> PARENT

# Optional: internal backend URL for server-side public pages (overrides above).
# API_URL_INTERNAL=http://localhost:4000

# Optional: output directory for `next build` (defaults to .next).
# NEXT_DIST_DIR=.next-demo