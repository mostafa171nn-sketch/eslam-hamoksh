# ===== معارچ (EduCenter SaaS) backend environment =====
# Copy to backend/.env and fill values. For Neon PostgreSQL the DATABASE_URL
# is the pooled connection string from the Neon dashboard.

NODE_ENV=development
PORT=4000

# Frontend origin(s), comma-separated. Used for CORS and email links.
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Neon PostgreSQL connection string (pooled). Example:
# postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/educenter?schema=public

# JWT secrets — generate with: openssl rand -base64 32 (min 32 characters)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-please
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-please
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=7

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10

# Email (optional — leave SMTP_HOST empty to disable sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Educational Center <no-reply@example.com>

# Exam auto-submit sweeper
EXAM_SWEEPER_INTERVAL_MS=30000

# OTP / SMS
OTP_DEV_MODE=true
SMS_PROVIDER=log
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=45
OTP_RESEND_LIMIT=5
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=