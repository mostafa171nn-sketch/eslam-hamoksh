generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                      @id @default(uuid())
  username             String                      @unique
  passwordHash         String
  fullName             String
  phone                String
  photo                String?
  role                 Role
  status               AccountStatus               @default(ACTIVE)
  email                String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  centerId             String?
  phoneE164            String?                     @unique
  phoneVerified        Boolean                     @default(false)
  phoneVerifiedAt      DateTime?
  activityLogs         ActivityLog[]
  centerRatings        CenterRating[]
  registrationRequests CenterRegistrationRequest[]
  documents            Document[]                  @relation("DocumentOwner")
  verifiedDocuments    Document[]                  @relation("DocumentVerifier")
  notifications        Notification[]
  parent               Parent?
  resetTokens          PasswordResetToken[]
  refreshTokens        RefreshToken[]
  student              Student?
  teacher              Teacher?
  assistantAssignments TeacherAssistant[]
  center               Center?                     @relation(fields: [centerId], references: [id])
  wallet               Wallet?

  @@index([role])
  @@index([status])
  @@index([centerId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Teacher {
  id                   String                  @id @default(uuid())
  userId               String                  @unique
  bio                  String?
  yearsExperience      Int                     @default(0)
  hourlyRate           Int                     @default(0)
  locationId           String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  centerId             String?
  assignments          Assignment[]
  billingSubscriptions BillingSubscription[]
  conversations        Conversation[]
  exams                Exam[]
  lessons              Lesson[]
  payments             Payment[]
  ratings              Rating[]
  settlements          Settlement[]
  center               Center?                 @relation(fields: [centerId], references: [id])
  location             Location?               @relation(fields: [locationId], references: [id])
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assistants           TeacherAssistant[]
  availability         TeacherAvailability[]
  grades               TeacherGrade[]
  paymentSettings      TeacherPaymentSettings?
  students             TeacherStudent[]
  subjects             TeacherSubject[]

  @@index([hourlyRate])
  @@index([locationId])
  @@index([centerId])
}

model Student {
  id                   String                 @id @default(uuid())
  userId               String                 @unique
  gradeId              String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  centerId             String?
  studentNumber        String?                @unique
  assignmentTargets    AssignmentStudent[]
  submissions          AssignmentSubmission[]
  attendance           Attendance[]
  attendanceQrSessions AttendanceQrSession[]
  billingSubscriptions BillingSubscription[]
  conversations        Conversation[]
  examAttempts         ExamAttempt[]
  examTargets          ExamStudent[]
  lessons              Lesson[]
  lessonEnrollments    LessonEnrollment[]
  parents              ParentStudent[]
  payments             Payment[]
  ratings              Rating[]
  center               Center?                @relation(fields: [centerId], references: [id])
  grade                Grade?                 @relation(fields: [gradeId], references: [id])
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentSubjects      StudentSubject[]
  teachers             TeacherStudent[]
  centerFollows        StudentCenterFollow[]

  @@index([gradeId])
  @@index([centerId])
  @@index([studentNumber])
}

model Parent {
  id                   String                @id @default(uuid())
  userId               String                @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  centerId             String?
  billingSubscriptions BillingSubscription[]
  center               Center?               @relation(fields: [centerId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  children             ParentStudent[]
  payments             Payment[]
  ratings              Rating[]

  @@index([centerId])
}

model Subject {
  id              String           @id @default(uuid())
  name            String           @unique
  icon            String?
  description     String?
  createdAt       DateTime         @default(now())
  assignments     Assignment[]
  exams           Exam[]
  lessons         Lesson[]
  studentSubjects StudentSubject[]
  teachers        TeacherSubject[]

  @@index([name])
}

model Grade {
  id        String         @id @default(uuid())
  name      String         @unique
  level     Int            @default(1)
  createdAt DateTime       @default(now())
  students  Student[]
  teachers  TeacherGrade[]

  @@index([name])
}

model Location {
  id           String                @id @default(uuid())
  name         String
  address      String?
  createdAt    DateTime              @default(now())
  centerId     String?
  lessons      Lesson[]
  center       Center?               @relation(fields: [centerId], references: [id], onDelete: Cascade)
  rooms        Room[]
  teachers     Teacher[]
  availability TeacherAvailability[]

  @@unique([centerId, name])
  @@index([name])
  @@index([centerId])
}

model TeacherSubject {
  teacherId String
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@index([subjectId])
}

model TeacherGrade {
  teacherId String
  gradeId   String
  grade     Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([teacherId, gradeId])
  @@index([gradeId])
}

model TeacherAvailability {
  id         String    @id @default(uuid())
  teacherId  String
  day        Int
  startTime  String
  endTime    String
  locationId String?
  createdAt  DateTime  @default(now())
  location   Location? @relation(fields: [locationId], references: [id])
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, day])
  @@index([locationId])
}

model TeacherStudent {
  teacherId String
  studentId String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([teacherId, studentId])
  @@index([studentId])
}

model ParentStudent {
  parentId  String
  studentId String
  createdAt DateTime @default(now())
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([studentId])
}

model TeacherAssistant {
  assistantId String
  teacherId   String
  centerId    String?
  createdAt   DateTime @default(now())
  assistant   User     @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  center      Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([assistantId, teacherId])
  @@index([teacherId])
  @@index([centerId])
}

model StudentSubject {
  studentId String
  subjectId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([studentId, subjectId])
  @@index([subjectId])
}

model Lesson {
  id                   String                @id @default(uuid())
  teacherId            String
  studentId            String?
  subjectId            String?
  date                 DateTime
  startTime            String
  endTime              String
  locationId           String?
  status               LessonStatus          @default(SCHEDULED)
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  centerId             String?
  capacity             Int?
  roomId               String?
  attendance           Attendance[]
  attendanceQrSessions AttendanceQrSession[]
  center               Center?               @relation(fields: [centerId], references: [id], onDelete: Cascade)
  location             Location?             @relation(fields: [locationId], references: [id])
  room                 Room?                 @relation(fields: [roomId], references: [id])
  student              Student?              @relation(fields: [studentId], references: [id])
  subject              Subject?              @relation(fields: [subjectId], references: [id])
  teacher              Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments          LessonEnrollment[]
  payments             Payment[]

  @@index([teacherId, date])
  @@index([studentId, date])
  @@index([date])
  @@index([status])
  @@index([locationId])
  @@index([roomId])
  @@index([centerId])
  @@index([subjectId])
}

model Attendance {
  id        String           @id @default(uuid())
  lessonId  String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  note      String?
  markedBy  String?
  createdAt DateTime         @default(now())
  markedAt  DateTime         @default(now())
  method    AttendanceMethod @default(MANUAL)
  updatedAt DateTime         @updatedAt
  centerId  String?
  center    Center?          @relation(fields: [centerId], references: [id], onDelete: Cascade)
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@index([lessonId])
  @@index([status])
  @@index([markedAt])
  @@index([centerId])
}

model AttendanceQrSession {
  id        String    @id @default(uuid())
  studentId String
  lessonId  String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  centerId  String?
  center    Center?   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([lessonId])
  @@index([centerId])
}

model Room {
  id         String     @id @default(uuid())
  name       String
  centerId   String
  locationId String?
  capacity   Int?
  floor      String?
  building   String?
  status     RoomStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  lessons    Lesson[]
  center     Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  location   Location?  @relation(fields: [locationId], references: [id])

  @@unique([centerId, name])
  @@index([centerId])
  @@index([locationId])
  @@index([status])
}

model LessonEnrollment {
  id         String                 @id @default(uuid())
  lessonId   String
  studentId  String
  status     LessonEnrollmentStatus @default(ENROLLED)
  enrolledAt DateTime               @default(now())
  enrolledBy String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  lesson     Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student    Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@index([lessonId])
  @@index([status])
}

model CenterSettings {
  id                     String   @id @default(uuid())
  name                   String   @default("Center")
  latitude               Float?
  longitude              Float?
  radiusMeters           Int      @default(100)
  attendanceGraceMinutes Int      @default(10)
  timezone               String   @default("Africa/Cairo")
  currency               String   @default("EGP")
  updatedAt              DateTime @updatedAt
  centerId               String?  @unique
  center                 Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
}

model Rating {
  id        String   @id @default(uuid())
  teacherId String
  studentId String?
  parentId  String?
  stars     Int
  comment   String?
  createdAt DateTime @default(now())
  parent    Parent?  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
  @@unique([teacherId, parentId])
  @@index([teacherId, stars])
  @@index([studentId])
  @@index([parentId])
}

model CenterRating {
  id        String   @id @default(uuid())
  centerId  String
  userId    String
  stars     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([centerId, userId])
  @@index([centerId, stars])
  @@index([userId])
}

model Assignment {
  id          String                 @id @default(uuid())
  teacherId   String
  subjectId   String?
  title       String
  description String?
  attachment  String?
  deadline    DateTime
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  centerId    String?
  center      Center?                @relation(fields: [centerId], references: [id], onDelete: Cascade)
  subject     Subject?               @relation(fields: [subjectId], references: [id])
  teacher     Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  students    AssignmentStudent[]
  submissions AssignmentSubmission[]

  @@index([teacherId])
  @@index([deadline])
  @@index([centerId])
  @@index([subjectId])
}

model AssignmentStudent {
  assignmentId String
  studentId    String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([assignmentId, studentId])
  @@index([studentId])
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  file         String?
  textAnswer   String?
  submittedAt  DateTime         @default(now())
  grade        Int?
  feedback     String?
  status       SubmissionStatus @default(SUBMITTED)
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([status])
}

model Exam {
  id              String         @id @default(uuid())
  teacherId       String
  subjectId       String?
  name            String
  description     String?
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  centerId        String?
  center          Center?        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  subject         Subject?       @relation(fields: [subjectId], references: [id])
  teacher         Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attempts        ExamAttempt[]
  questions       ExamQuestion[]
  students        ExamStudent[]

  @@index([teacherId])
  @@index([startTime, endTime])
  @@index([centerId])
  @@index([subjectId])
}

model ExamStudent {
  examId    String
  studentId String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([examId, studentId])
  @@index([studentId])
}

model ExamQuestion {
  id            String           @id @default(uuid())
  examId        String
  type          ExamQuestionType @default(MULTIPLE_CHOICE)
  question      String
  options       String?
  correctAnswer String?
  points        Int              @default(1)
  order         Int              @default(0)
  createdAt     DateTime         @default(now())
  answers       ExamAnswer[]
  exam          Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model ExamAttempt {
  id           String        @id @default(uuid())
  examId       String
  studentId    String
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  score        Int?
  maxScore     Int           @default(0)
  percentage   Float?
  correctCount Int           @default(0)
  totalCount   Int           @default(0)
  status       AttemptStatus @default(IN_PROGRESS)
  createdAt    DateTime      @default(now())
  answers      ExamAnswer[]
  exam         Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([status])
}

model ExamAnswer {
  id         String       @id @default(uuid())
  attemptId  String
  questionId String
  answer     String?
  isCorrect  Boolean?
  points     Int          @default(0)
  updatedAt  DateTime     @updatedAt
  attempt    ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  role      String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  centerId  String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([centerId])
  @@index([entity, entityId])
}

model TeacherPaymentSettings {
  id             String   @id @default(uuid())
  teacherId      String   @unique
  sessionEnabled Boolean  @default(true)
  monthlyEnabled Boolean  @default(false)
  sessionPrice   Int      @default(0)
  monthlyPrice   Int      @default(0)
  vodafoneCash   String?
  etisalatCash   String?
  orangeCash     String?
  instaPay       String?
  telda          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  teacher        Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model BillingSubscription {
  id            String             @id @default(uuid())
  studentId     String
  parentId      String?
  teacherId     String
  centerId      String?
  monthlyPrice  Int
  startDate     DateTime           @default(now())
  endDate       DateTime
  paymentMethod PaymentMethod?
  status        SubscriptionStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  center        Center?            @relation(fields: [centerId], references: [id], onDelete: Cascade)
  parent        Parent?            @relation(fields: [parentId], references: [id])
  student       Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher       Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([studentId])
  @@index([teacherId])
  @@index([status])
  @@index([centerId])
}

model Payment {
  id                   String                 @id @default(uuid())
  paymentNumber        String                 @unique
  payerId              String
  payerName            String
  studentId            String
  parentId             String?
  teacherId            String
  lessonId             String?
  subscriptionId       String?
  amount               Int
  currency             String                 @default("EGP")
  type                 PaymentType
  method               PaymentMethod
  status               PaymentStatus          @default(PENDING)
  transactionReference String?
  proofUrl             String?
  rejectionReason      String?
  approvedById         String?
  paidAt               DateTime?
  refundedAt           DateTime?
  refundAmount         Int?
  refundReason         String?
  refundedById         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  centerId             String?
  invoices             Invoice[]
  center               Center?                @relation(fields: [centerId], references: [id], onDelete: Cascade)
  lesson               Lesson?                @relation(fields: [lessonId], references: [id])
  parent               Parent?                @relation(fields: [parentId], references: [id])
  student              Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  billingSubscription  BillingSubscription?   @relation(fields: [subscriptionId], references: [id])
  teacher              Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  history              PaymentStatusHistory[]

  @@index([payerId])
  @@index([studentId])
  @@index([parentId])
  @@index([teacherId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@index([paymentNumber])
  @@index([centerId])
}

model PaymentStatusHistory {
  id            String         @id @default(uuid())
  paymentId     String
  oldStatus     PaymentStatus?
  newStatus     PaymentStatus
  changedById   String?
  changedByName String?
  reason        String?
  createdAt     DateTime       @default(now())
  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Center {
  id                    String                      @id @default(uuid())
  name                  String
  nameEn                String?
  slug                  String                      @unique
  address               String?
  city                  String?
  phone                 String?
  email                 String?
  website               String?
  logoUrl               String?
  description           String?
  status                CenterStatus                @default(PENDING)
  subscriptionStatus    SubscriptionStatus          @default(PENDING)
  planId                String?
  subscriptionStartsAt  DateTime?
  subscriptionExpiresAt DateTime?
  requiresApproval      Boolean                     @default(true)
  approvedById          String?
  approvedAt            DateTime?
  rejectedReason        String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  cancelledAt           DateTime?
  cancelledReason       String?
  assignments           Assignment[]
  attendance            Attendance[]
  attendanceQrSessions  AttendanceQrSession[]
  billingSubscriptions  BillingSubscription[]
  plan                  SubscriptionPlan?           @relation(fields: [planId], references: [id])
  centerRatings         CenterRating[]
  registrationRequests  CenterRegistrationRequest[]
  settings              CenterSettings?
  conversations         Conversation[]
  documents             Document[]
  exams                 Exam[]
  invoices              Invoice[]
  lessons               Lesson[]
  locations             Location[]
  parents               Parent[]
  payments              Payment[]
  rooms                 Room[]
  settlements           Settlement[]
  students              Student[]
  teachers              Teacher[]
  teacherAssistants     TeacherAssistant[]
  users                 User[]
  wallets               Wallet[]
  studentCenterFollows  StudentCenterFollow[]

  @@index([status])
  @@index([subscriptionStatus])
  @@index([planId])
}

model SubscriptionPlan {
  id                  String        @id @default(uuid())
  name                String        @unique
  description         String?
  priceMonthly        Int           @default(0)
  currency            String        @default("EGP")
  maxTeachers         Int?
  maxStudents         Int?
  includesChat        Boolean       @default(true)
  includesExams       Boolean       @default(true)
  includesAssignments Boolean       @default(true)
  includesAttendance  Boolean       @default(true)
  includesPayments    Boolean       @default(true)
  includesAnalytics   Boolean       @default(true)
  includesMultiBranch Boolean       @default(false)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  billingPeriod       BillingPeriod @default(MONTHLY)
  commissionRate      Float         @default(0)
  maxAssistants       Int?
  maxEmployees        Int?
  maxRooms            Int?
  type                PlanType      @default(CENTER)
  centers             Center[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  domain      String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([domain])
}

model RolePermission {
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([permissionId])
}

model Conversation {
  id        String    @id @default(uuid())
  centerId  String?
  teacherId String
  studentId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  center    Center?   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([teacherId, studentId])
  @@index([centerId])
  @@index([teacherId])
  @@index([studentId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  senderRole     Role
  body           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balance      Int                 @default(0)
  currency     String              @default("EGP")
  centerId     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  status       WalletStatus        @default(ACTIVE)
  center       Center?             @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([centerId])
  @@index([status])
}

model WalletTransaction {
  id            String                @id @default(uuid())
  walletId      String
  type          WalletTransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  reference     String?
  description   String?
  createdBy     String?
  createdAt     DateTime              @default(now())
  referenceId   String?
  referenceType String?
  wallet        Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model CenterRegistrationRequest {
  id           String                    @id @default(uuid())
  centerId     String
  requesterId  String
  status       RegistrationRequestStatus @default(PENDING)
  reason       String?
  reviewNotes  String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  center       Center                    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  requester    User                      @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@index([requesterId])
  @@index([status])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  paymentId     String?
  centerId      String?
  amount        Int
  currency      String        @default("EGP")
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  description   String?
  dueAt         DateTime?
  payerId       String?
  payerName     String?
  center        Center?       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  payment       Payment?      @relation(fields: [paymentId], references: [id])

  @@index([centerId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([payerId])
}

model Settlement {
  id                 String           @id @default(uuid())
  centerId           String
  teacherId          String
  period             String
  grossAmount        Int
  platformCommission Int
  teacherShare       Int
  centerShare        Int
  netAmount          Int
  status             SettlementStatus @default(PENDING)
  settledAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  notes              String?
  settlementNumber   String           @unique
  center             Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacher            Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@index([teacherId])
  @@index([status])
  @@index([period])
  @@index([settlementNumber])
}

model Document {
  id              String         @id @default(uuid())
  title           String
  description     String?
  type            DocumentType   @default(OTHER)
  status          DocumentStatus @default(PENDING)
  fileUrl         String
  mimeType        String?
  fileSize        Int?
  ownerId         String
  centerId        String?
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  center          Center?        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  owner           User           @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  verifiedBy      User?          @relation("DocumentVerifier", fields: [verifiedById], references: [id])

  @@index([ownerId])
  @@index([centerId])
  @@index([status])
  @@index([type])
}

model StudentCenterFollow {
  id        String   @id @default(uuid())
  studentId String
  centerId  String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@unique([studentId, centerId])
  @@index([studentId])
  @@index([centerId])
}

model NotificationTemplate {
  id            String           @id @default(uuid())
  key           String           @unique
  titleTemplate String
  bodyTemplate  String
  type          NotificationType @default(GENERAL)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model PhoneVerification {
  id          String    @id @default(uuid())
  phoneE164   String
  phoneRaw    String?
  purpose     String
  otpHash     String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  resendCount Int       @default(0)
  expiresAt   DateTime
  verifiedAt  DateTime?
  payloadEnc  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([phoneE164])
  @@index([expiresAt])
  @@index([purpose])
}

