// Educational Center Management System - Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  CENTER_ADMIN
  CENTER_EMPLOYEE
  RECEPTIONIST
  TEACHER
  TEACHER_ASSISTANT
  STUDENT
  PARENT
  ADMIN // legacy alias for CENTER_ADMIN (kept for backwards compatibility)
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  REJECTED
}

enum CenterStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum LessonEnrollmentStatus {
  ENROLLED
  CANCELLED
  COMPLETED
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  GRADED
  LATE
}

enum ExamQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  WRITTEN
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceMethod {
  QR
  MANUAL
  SYSTEM
}

enum PaymentType {
  SESSION
  MONTHLY
}

enum PaymentMethod {
  VODAFONE_CASH
  ETISALAT_CASH
  ORANGE_CASH
  INSTAPAY
  TELDA
  CASH
  WALLET
  LATER
  WISE
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
  EXPIRED
  REFUNDED
  COMPLETED
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  SUSPENDED
  EXPIRED
  CANCELLED
  TRIAL
  PAST_DUE
}

enum PlanType {
  CENTER
  TEACHER
  STUDENT
  PARENT
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum WalletTransactionType {
  DEPOSIT
  PURCHASE
  REFUND
  ADJUSTMENT
  COMMISSION
  WITHDRAWAL
  SETTLEMENT
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum SettlementStatus {
  PENDING
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
  OVERDUE
  VOIDED
}

enum NotificationType {
  HOMEWORK
  EXAM
  EXAM_REMINDER
  DEADLINE
  LESSON_CHANGE
  LESSON_CANCELLED
  LESSON_RESCHEDULED
  RESULT
  GRADED
  RATING
  SYSTEM
  GENERAL
}

enum DocumentType {
  ACADEMIC_CERTIFICATE
  NATIONAL_ID
  TRANSCRIPT
  PHOTO
  CONTRACT
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  passwordHash String
  fullName     String
  phone        String
  phoneE164    String?  @unique
  phoneVerified Boolean @default(false)
  phoneVerifiedAt DateTime?
  photo        String?
  role         Role
  status       AccountStatus @default(ACTIVE)
  email        String?
  centerId     String?
  center       Center?       @relation(fields: [centerId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  teacher              Teacher?
  student              Student?
  parent               Parent?
  assistantAssignments TeacherAssistant[]
  wallet               Wallet?
  refreshTokens        RefreshToken[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  resetTokens          PasswordResetToken[]
  registrationRequests CenterRegistrationRequest[]
  documents            Document[]           @relation("DocumentOwner")
  verifiedDocuments    Document[]           @relation("DocumentVerifier")
  centerRatings        CenterRating[]
  @@index([role])
  @@index([status])
  @@index([centerId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Teacher {
  id              String                  @id @default(uuid())
  userId          String                  @unique
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  centerId        String?
  center          Center?                 @relation(fields: [centerId], references: [id], onDelete: SetNull)
  bio             String?
  yearsExperience Int                     @default(0)
  hourlyRate      Int                     @default(0)
  locationId      String?
  location        Location?               @relation(fields: [locationId], references: [id])
  subjects        TeacherSubject[]
  grades          TeacherGrade[]
  availability    TeacherAvailability[]
  students        TeacherStudent[]
  assistants      TeacherAssistant[]
  lessons         Lesson[]
  ratings         Rating[]
  assignments     Assignment[]
  exams           Exam[]
  paymentSettings TeacherPaymentSettings?
   payments        Payment[]
   billingSubscriptions BillingSubscription[]
   conversations   Conversation[]
  settlements     Settlement[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([hourlyRate])
  @@index([locationId])
  @@index([centerId])
}

model Student {
  id                   String                 @id @default(uuid())
  userId               String                 @unique
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  centerId             String?
  center               Center?                @relation(fields: [centerId], references: [id], onDelete: SetNull)
  studentNumber        String?                @unique
  gradeId              String?
  grade                Grade?                 @relation(fields: [gradeId], references: [id])
  teachers             TeacherStudent[]
  parents              ParentStudent[]
  studentSubjects      StudentSubject[]
  lessons              Lesson[]
  ratings              Rating[]
  assignmentTargets    AssignmentStudent[]
  submissions          AssignmentSubmission[]
  examTargets          ExamStudent[]
  examAttempts         ExamAttempt[]
  attendance           Attendance[]
  attendanceQrSessions AttendanceQrSession[]
   payments             Payment[]
   billingSubscriptions BillingSubscription[]
   conversations        Conversation[]
   lessonEnrollments    LessonEnrollment[]
   createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([gradeId])
  @@index([centerId])
  @@index([studentNumber])
}

model Parent {
  id                   String                @id @default(uuid())
  userId               String                @unique
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  centerId             String?
  center               Center?               @relation(fields: [centerId], references: [id], onDelete: SetNull)
  children             ParentStudent[]
  ratings              Rating[]
  payments             Payment[]
  billingSubscriptions BillingSubscription[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([centerId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Subject {
  id              String           @id @default(uuid())
  name            String           @unique
  icon            String?
  description     String?
  teachers        TeacherSubject[]
  lessons         Lesson[]
  assignments     Assignment[]
  exams           Exam[]
  studentSubjects StudentSubject[]
  createdAt       DateTime         @default(now())

  @@index([name])
}

model Grade {
  id        String         @id @default(uuid())
  name      String         @unique
  level     Int            @default(1)
  students  Student[]
  teachers  TeacherGrade[]
  createdAt DateTime       @default(now())

  @@index([name])
}

model Location {
  id           String                @id @default(uuid())
  name         String
  address      String?
  centerId     String?
  center       Center?               @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teachers     Teacher[]
  availability TeacherAvailability[]
  lessons      Lesson[]
  rooms        Room[]
  createdAt    DateTime              @default(now())

  @@unique([centerId, name])
  @@index([name])
  @@index([centerId])
}

// ---------------------------------------------------------------------------
// Teacher relations
// ---------------------------------------------------------------------------

model TeacherSubject {
  teacherId String
  subjectId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@index([subjectId])
}

model TeacherGrade {
  teacherId String
  gradeId   String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  grade     Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@id([teacherId, gradeId])
  @@index([gradeId])
}

model TeacherAvailability {
  id         String    @id @default(uuid())
  teacherId  String
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  day        Int
  startTime  String
  endTime    String
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([teacherId, day])
  @@index([locationId])
}

model TeacherStudent {
  teacherId String
  studentId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([teacherId, studentId])
  @@index([studentId])
}

model ParentStudent {
  parentId  String
  studentId String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([parentId, studentId])
  @@index([studentId])
}

model TeacherAssistant {
  assistantId String
  teacherId   String
  centerId    String?
  assistant   User     @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  center      Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([assistantId, teacherId])
  @@index([teacherId])
  @@index([centerId])
}

model StudentSubject {
  studentId String
  subjectId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([studentId, subjectId])
  @@index([subjectId])
}

// ---------------------------------------------------------------------------
// Lessons & attendance
// ---------------------------------------------------------------------------

model Lesson {
  id         String       @id @default(uuid())
  teacherId  String
  studentId  String?
  subjectId  String?
  date       DateTime
  startTime  String
  endTime    String
  locationId String?
  roomId     String?
  capacity   Int?
  status     LessonStatus @default(SCHEDULED)
  notes      String?
  centerId   String?
  center     Center?      @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  teacher              Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student              Student?              @relation(fields: [studentId], references: [id], onDelete: SetNull)
  subject              Subject?              @relation(fields: [subjectId], references: [id])
  location             Location?             @relation(fields: [locationId], references: [id])
  room                 Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  attendance           Attendance[]
  attendanceQrSessions AttendanceQrSession[]
  payments             Payment[]
  enrollments          LessonEnrollment[]

  @@index([teacherId, date])
  @@index([studentId, date])
  @@index([date])
  @@index([status])
  @@index([locationId])
  @@index([roomId])
  @@index([centerId])
  @@index([subjectId])
}

model Attendance {
  id        String           @id @default(uuid())
  lessonId  String
  studentId String
  centerId  String?
  center    Center?          @relation(fields: [centerId], references: [id], onDelete: Cascade)
  status    AttendanceStatus @default(PRESENT)
  method    AttendanceMethod @default(MANUAL)
  note      String?
  markedBy  String?
  markedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@index([lessonId])
  @@index([status])
  @@index([markedAt])
  @@index([centerId])
}

// Short-lived, single-use attendance QR tokens. Only the hash is stored
// server-side; the plaintext token is returned to the student and embedded
// in the QR code. Tokens are strictly lesson- and student-specific.
model AttendanceQrSession {
  id        String    @id @default(uuid())
  studentId String
  lessonId  String
  centerId  String?
  center    Center?   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([lessonId])
  @@index([centerId])
}

// ---------------------------------------------------------------------------
// Rooms & Enrollments
// ---------------------------------------------------------------------------

model Room {
  id         String     @id @default(uuid())
  name       String
  centerId   String
  center     Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  capacity   Int?
  floor      String?
  building   String?
  status     RoomStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  lessons Lesson[]

  @@unique([centerId, name])
  @@index([centerId])
  @@index([locationId])
  @@index([status])
}

model LessonEnrollment {
  id        String                    @id @default(uuid())
  lessonId  String
  studentId String
  status    LessonEnrollmentStatus    @default(ENROLLED)
  enrolledAt DateTime                 @default(now())
  enrolledBy String?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@index([lessonId])
  @@index([status])
}

// Per-center configuration owned by the admin. Stores the GPS anchor
// used for attendance verification plus attendance timing rules.
model CenterSettings {
  id                     String   @id @default(uuid())
  centerId               String?  @unique
  center                 Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  name                   String   @default("Center")
  latitude               Float?
  longitude              Float?
  radiusMeters           Int      @default(100)
  attendanceGraceMinutes Int      @default(10)
  timezone               String   @default("Africa/Cairo")
  currency               String   @default("EGP")
  updatedAt              DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Ratings & reviews
// ---------------------------------------------------------------------------

model Rating {
  id        String   @id @default(uuid())
  teacherId String
  studentId String?
  parentId  String?
  stars     Int
  comment   String?
  createdAt DateTime @default(now())

  teacher Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent?  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
  @@unique([teacherId, parentId])
  @@index([teacherId, stars])
  @@index([studentId])
  @@index([parentId])
}

// Center (tenant) level ratings. One rating per user per center; the numeric
// score is stored exactly as submitted (1-5) and aggregated on read.
model CenterRating {
  id        String   @id @default(uuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stars     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([centerId, userId])
  @@index([centerId, stars])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Assignments & homework
// ---------------------------------------------------------------------------

model Assignment {
  id          String   @id @default(uuid())
  teacherId   String
  centerId    String?
  center      Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  subjectId   String?
  title       String
  description String?
  attachment  String?
  deadline    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject     Subject?               @relation(fields: [subjectId], references: [id])
  students    AssignmentStudent[]
  submissions AssignmentSubmission[]

  @@index([teacherId])
  @@index([deadline])
  @@index([centerId])
  @@index([subjectId])
}

model AssignmentStudent {
  assignmentId String
  studentId    String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([assignmentId, studentId])
  @@index([studentId])
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  file         String?
  textAnswer   String?
  submittedAt  DateTime         @default(now())
  grade        Int?
  feedback     String?
  status       SubmissionStatus @default(SUBMITTED)
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Exams
// ---------------------------------------------------------------------------

model Exam {
  id              String   @id @default(uuid())
  teacherId       String
  centerId        String?
  center          Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  subjectId       String?
  name            String
  description     String?
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teacher   Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject?       @relation(fields: [subjectId], references: [id])
  students  ExamStudent[]
  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([teacherId])
  @@index([startTime, endTime])
  @@index([centerId])
  @@index([subjectId])
}

model ExamStudent {
  examId    String
  studentId String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([examId, studentId])
  @@index([studentId])
}

model ExamQuestion {
  id            String           @id @default(uuid())
  examId        String
  type          ExamQuestionType @default(MULTIPLE_CHOICE)
  question      String
  options       String? // JSON array for multiple choice
  correctAnswer String?
  points        Int              @default(1)
  order         Int              @default(0)
  createdAt     DateTime         @default(now())

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]

  @@index([examId])
}

model ExamAttempt {
  id           String        @id @default(uuid())
  examId       String
  studentId    String
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  score        Int?
  maxScore     Int           @default(0)
  percentage   Float?
  correctCount Int           @default(0)
  totalCount   Int           @default(0)
  status       AttemptStatus @default(IN_PROGRESS)
  createdAt    DateTime      @default(now())

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([status])
}

model ExamAnswer {
  id         String   @id @default(uuid())
  attemptId  String
  questionId String
  answer     String?
  isCorrect  Boolean?
  points     Int      @default(0)
  updatedAt  DateTime @updatedAt

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Notifications & activity
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  centerId  String?
  role      String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([centerId])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Payments & subscriptions
// ---------------------------------------------------------------------------

// Per-teacher configuration of supported payment models and destination
// identifiers. Only minimum routing information is stored; never credentials.
model TeacherPaymentSettings {
  id             String   @id @default(uuid())
  teacherId      String   @unique
  teacher        Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sessionEnabled Boolean  @default(true)
  monthlyEnabled Boolean  @default(false)
  sessionPrice   Int      @default(0)
  monthlyPrice   Int      @default(0)
  vodafoneCash   String?
  etisalatCash   String?
  orangeCash     String?
  instaPay       String?
  telda          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BillingSubscription {
  id            String             @id @default(uuid())
  studentId     String
  student       Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        Parent?            @relation(fields: [parentId], references: [id], onDelete: SetNull)
  teacherId     String
  teacher       Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  centerId      String?
  center        Center?            @relation(fields: [centerId], references: [id], onDelete: Cascade)
  monthlyPrice  Int
  startDate     DateTime           @default(now())
  endDate       DateTime
  paymentMethod PaymentMethod?
  status        SubscriptionStatus @default(PENDING)
  createdAt     DateTime           @default(now())

  payments Payment[]

  @@index([studentId])
  @@index([teacherId])
  @@index([status])
  @@index([centerId])
}

model Payment {
  id                   String        @id @default(uuid())
  paymentNumber        String        @unique
  payerId              String
  payerName            String
  studentId            String
  student              Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId             String?
  parent               Parent?       @relation(fields: [parentId], references: [id], onDelete: SetNull)
  teacherId            String
  teacher              Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  centerId             String?
  center               Center?       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  lessonId             String?
  lesson               Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  subscriptionId       String?
  billingSubscription BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount               Int
  currency             String        @default("EGP")
  type                 PaymentType
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  transactionReference String?
  proofUrl             String?
  rejectionReason      String?
  approvedById         String?
  paidAt               DateTime?
  refundedAt           DateTime?
  refundAmount         Int?
  refundReason         String?
  refundedById         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  history  PaymentStatusHistory[]
  invoices Invoice[]

  @@index([payerId])
  @@index([studentId])
  @@index([parentId])
  @@index([teacherId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@index([paymentNumber])
  @@index([centerId])
}

model PaymentStatusHistory {
  id            String         @id @default(uuid())
  paymentId     String
  oldStatus     PaymentStatus?
  newStatus     PaymentStatus
  changedById   String?
  changedByName String?
  reason        String?
  createdAt     DateTime       @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Multi-tenancy: Centers (tenants)
// ---------------------------------------------------------------------------

model Center {
  id                    String             @id @default(uuid())
  name                  String
  nameEn                String?
  slug                  String             @unique
  address               String?
  city                  String?
  phone                 String?
  email                 String?
  website               String?
  logoUrl               String?
  description           String?
  status                CenterStatus       @default(PENDING)
  // SaaS subscription state for the whole tenant.
  subscriptionStatus    SubscriptionStatus @default(PENDING)
  planId                String?
  plan                  SubscriptionPlan?  @relation(fields: [planId], references: [id])
  subscriptionStartsAt  DateTime?
  subscriptionExpiresAt DateTime?
  cancelledAt           DateTime?
  cancelledReason       String?
  // When true, the center cannot be used until a SUPER_ADMIN approves it.
  requiresApproval      Boolean            @default(true)
  approvedById          String?
  approvedAt            DateTime?
  rejectedReason        String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  users                User[]
  teachers             Teacher[]
  students             Student[]
  parents              Parent[]
  lessons              Lesson[]
  attendance           Attendance[]
   attendanceQrSessions AttendanceQrSession[]
   billingSubscriptions BillingSubscription[]
   payments             Payment[]
  assignments          Assignment[]
  exams                Exam[]
  locations            Location[]
  settings             CenterSettings?
  conversations        Conversation[]
  wallets              Wallet[]
  registrationRequests CenterRegistrationRequest[]
   teacherAssistants    TeacherAssistant[]
   invoices             Invoice[]
    settlements          Settlement[]
    rooms                Room[]
    documents            Document[]
  centerRatings        CenterRating[]

  @@index([status])
  @@index([subscriptionStatus])
  @@index([planId])
}

// SaaS subscription plans. Feature flags control which capabilities a center
// may use. New plans can be created by the SUPER_ADMIN without code changes.
model SubscriptionPlan {
  id                  String        @id @default(uuid())
  name                String        @unique
  description         String?
  type                PlanType      @default(CENTER)
  billingPeriod       BillingPeriod @default(MONTHLY)
  priceMonthly        Int           @default(0)
  currency            String        @default("EGP")
  maxTeachers         Int?
  maxStudents         Int?
  maxEmployees        Int?
  maxAssistants       Int?
  maxRooms            Int?
  commissionRate      Float         @default(0)
  includesChat        Boolean       @default(true)
  includesExams       Boolean       @default(true)
  includesAssignments Boolean       @default(true)
  includesAttendance  Boolean       @default(true)
  includesPayments    Boolean       @default(true)
  includesAnalytics   Boolean       @default(true)
  includesMultiBranch Boolean       @default(false)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  centers Center[]
}

// ---------------------------------------------------------------------------
// RBAC: Permissions & role-permission mapping
// ---------------------------------------------------------------------------

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  domain      String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([domain])
}

model RolePermission {
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([role, permissionId])
  @@index([permissionId])
}

// ---------------------------------------------------------------------------
// Chat (teacher <-> student)
// ---------------------------------------------------------------------------

model Conversation {
  id        String    @id @default(uuid())
  centerId  String?
  center    Center?   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacherId String
  studentId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@unique([teacherId, studentId])
  @@index([centerId])
  @@index([teacherId])
  @@index([studentId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderRole     Role
  body           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ---------------------------------------------------------------------------
// Financial: Wallets & transactions
// ---------------------------------------------------------------------------

model Wallet {
  id        String       @id @default(uuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int          @default(0)
  currency  String       @default("EGP")
  status    WalletStatus @default(ACTIVE)
  centerId  String?
  center    Center?      @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  transactions WalletTransaction[]

  @@index([centerId])
  @@index([status])
}

model WalletTransaction {
  id            String                @id @default(uuid())
  walletId      String
  wallet        Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          WalletTransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  referenceType String?
  referenceId   String?
  reference     String?
  description   String?
  createdBy     String?
  createdAt     DateTime              @default(now())

  @@index([walletId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Center registration requests
// ---------------------------------------------------------------------------

model CenterRegistrationRequest {
  id           String                    @id @default(uuid())
  centerId     String
  center       Center                    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  requesterId  String
  requester    User                      @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  status       RegistrationRequestStatus @default(PENDING)
  reason       String?
  reviewNotes  String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([centerId])
  @@index([requesterId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Financial: Invoices & settlements
// ---------------------------------------------------------------------------

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  paymentId     String?
  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  centerId      String?
  center        Center?       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  payerId       String?
  payerName     String?
  amount        Int
  currency      String        @default("EGP")
  description   String?
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?
  dueAt         DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([centerId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([payerId])
}

model Settlement {
  id                 String           @id @default(uuid())
  settlementNumber   String           @unique
  centerId           String
  center             Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacherId          String
  teacher            Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  period             String
  grossAmount        Int
  platformCommission Int
  teacherShare       Int
  centerShare        Int
  netAmount          Int
  status             SettlementStatus @default(PENDING)
  notes              String?
  settledAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([centerId])
  @@index([teacherId])
  @@index([status])
  @@index([period])
  @@index([settlementNumber])
}

// ---------------------------------------------------------------------------
// Document Management
// ---------------------------------------------------------------------------

model Document {
  id              String         @id @default(uuid())
  title           String
  description     String?
  type            DocumentType   @default(OTHER)
  status          DocumentStatus @default(PENDING)
  fileUrl         String
  mimeType        String?
  fileSize        Int?
  ownerId         String
  owner           User           @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  centerId        String?
  center          Center?        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  verifiedById    String?
  verifiedBy      User?          @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt      DateTime?
  rejectionReason String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([ownerId])
  @@index([centerId])
  @@index([status])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Notification Templates
// ---------------------------------------------------------------------------

model NotificationTemplate {
  id            String           @id @default(uuid())
  key           String           @unique
  titleTemplate String
  bodyTemplate  String
  type          NotificationType @default(GENERAL)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model PhoneVerification {
  id            String    @id @default(uuid())
  phoneE164     String
  phoneRaw      String?
  purpose       String
  otpHash       String
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  resendCount   Int       @default(0)
  expiresAt     DateTime
  verifiedAt    DateTime?
  payloadEnc    String?   // encrypted JSON of pending registration
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([phoneE164])
  @@index([expiresAt])
  @@index([purpose])
}